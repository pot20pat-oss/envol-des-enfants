{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "envol-des-enfants",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "envol-des-enfants-db",
      "database_id": "4d1028e3-1ef5-4297-afeb-511c88903cbb",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "envol-des-enfants-images"
    }
  ],
  "observability": { "enabled": true }
}
